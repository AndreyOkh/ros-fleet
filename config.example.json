{
  "config_version": 2,
  "binary_backup_dir": "./backups/binary",
  "export_dir": "./backups/exports",
  "state_file": "./state.json",
  "retention_days": 30,
  "concurrency": 5,
  "timeout_sec": 120,
  "schedule": {
    "times": [
      "03:00",
      "15:00"
    ],
    "timezone": "Europe/Moscow"
  },
  "defaults": {
    "port": 22,
    "user": "backup_user",
    "password": "",
    "private_key_path": "/home/rosfleet/.ssh/id_ed25519",
    "private_key_passphrase": "",
    "insecure_ignore_host_key": true,
    "export_sensitive": true,
    "encrypt_backup": false,
    "backup_password": ""
  },
  "git": {
    "enabled": true,
    "remote_url": "https://github.com/your-org/mikrotik-configs.git",
    "branch": "main",
    "author_name": "ros-fleet",
    "author_email": "ros-fleet@local",
    "auto_push": false,
    "access_token": ""
  },
  "web": {
    "enabled": true,
    "listen_addr": ":8080",
    "auth_user": "admin",
    "auth_password": ""
  },
  "telegram": {
    "enabled": false,
    "bot_token": "123456789:ABCdefGHIjklMNOpqrSTUvwxYZ",
    "chat_id": "-1001234567890",
    "notify_on_success": true,
    "timeout_sec": 15
  },
  "updates": {
    "enabled": true
  },
  "routers": [
    {
      "enabled": true,
      "name": "Router-Core-CCR2004",
      "host": "192.168.1.1"
    },
    {
      "enabled": true,
      "name": "Router-Office-RB4011",
      "host": "192.168.10.1",
      "password": "RouterCustomPassword",
      "encrypt_backup": true,
      "backup_password": "SuperSecretBackupPassword123!"
    },
    {
      "enabled": false,
      "name": "Router-Warehouse-Legacy",
      "host": "10.50.0.1",
      "port": 2222,
      "user": "admin",
      "password": "LegacyPasswordExample",
      "export_sensitive": false
    }
  ]
}
