[Unit]
Description=MikroTik RouterOS Automated Backup Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mikrotik-backup
Group=mikrotik-backup
WorkingDirectory=/opt/mikrotik-backup
ExecStart=/opt/mikrotik-backup/mikrotik-backup -config /opt/mikrotik-backup/config.json
Restart=always
RestartSec=30
TimeoutStopSec=60

# Security Hardening
ProtectSystem=full
ProtectHome=read-only
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
